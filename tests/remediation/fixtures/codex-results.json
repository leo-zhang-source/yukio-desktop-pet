{
  "schema_version": 1,
  "session": "fixture-stage2-session",
  "description": "人工构造，不含真实聊天。expect_events 比较完成、失败、取消投影；activity_end 只表示结束，不等于成功。expect_result 同时检查 Mac 与工作台的事实元数据。",
  "cases": [
    {
      "id": "sequential_success",
      "purpose": "明确的成功结果结束自己的操作。",
      "steps": [
        {
          "record": {
            "type": "task_started",
            "turn_id": "t1"
          },
          "expect_events": []
        },
        {
          "record": {
            "type": "function_call",
            "name": "shell",
            "call_id": "a",
            "arguments": "{\"command\":[\"printf\",\"fixture\"]}"
          },
          "expect_events": []
        },
        {
          "record": {
            "type": "function_call_output",
            "call_id": "a",
            "output": "{\"metadata\":{\"exit_code\":0}}"
          },
          "expect_events": [
            {
              "kind": "activity_end",
              "id": "a"
            }
          ],
          "expect_result": {
            "outcome": "succeeded",
            "call_outcome": "succeeded",
            "call_id": "a"
          }
        }
      ]
    },
    {
      "id": "interleaved_failure",
      "purpose": "A 失败而 B 成功；B 先结束也不能继承 A 的失败。",
      "steps": [
        {
          "record": {
            "type": "task_started",
            "turn_id": "t1"
          },
          "expect_events": []
        },
        {
          "record": {
            "type": "function_call",
            "name": "shell",
            "call_id": "a",
            "arguments": "{\"command\":[\"printf\",\"fixture\"]}"
          },
          "expect_events": []
        },
        {
          "record": {
            "type": "function_call",
            "name": "shell",
            "call_id": "b",
            "arguments": "{\"command\":[\"printf\",\"fixture\"]}"
          },
          "expect_events": []
        },
        {
          "record": {
            "type": "item_completed",
            "item": {
              "type": "CommandExecution",
              "call_id": "a",
              "status": "failed"
            }
          },
          "expect_events": [],
          "expect_result": {
            "outcome": "failed",
            "association": "explicit_call_id",
            "call_id": "a"
          }
        },
        {
          "record": {
            "type": "function_call_output",
            "call_id": "b",
            "output": "{\"metadata\":{\"exit_code\":0}}"
          },
          "expect_events": [
            {
              "kind": "activity_end",
              "id": "b"
            }
          ],
          "expect_result": {
            "call_outcome": "succeeded",
            "call_id": "b"
          }
        },
        {
          "record": {
            "type": "function_call_output",
            "call_id": "a",
            "output": "fixture output"
          },
          "expect_events": [
            {
              "kind": "activity_failed",
              "id": "a"
            }
          ],
          "expect_result": {
            "outcome": "unknown",
            "call_outcome": "failed",
            "call_id": "a"
          }
        }
      ]
    },
